# Local placeholders only
NODE_ENV=development
API_PORT=3001
CRM_PORT=5173
PORTAL_PORT=3000
# Set these locally in ignored .env; never commit passwords.
# Runtime: dolphin_crm_dev_app; migration CLI: dolphin_crm_dev_migrator.
DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=redis://localhost:6379
CRM_ORIGIN=http://localhost:5173

# Identity development is emulator-only. Do not replace with production values.
FIREBASE_PROJECT_ID=dolphin-air-local
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
ADMIN_PASSWORD=

# CRM web identity uses Firebase Auth Emulator only in development.
VITE_API_URL=http://localhost:3001
VITE_FIREBASE_API_KEY=demo-dolphin-air-local
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=dolphin-air-local
VITE_FIREBASE_APP_ID=dolphin-air-local-web
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_CUSTOMER_AUTH_ENABLED=false

